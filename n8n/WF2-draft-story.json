      {
        "parameters": {
          "jsCode": "const src = $('Build Prompt').first().json;\nconst item = $json;\nlet d;\nif (item.glance && item.deep_dive) {\n  d = item;\n} else {\n  const parts = item?.content?.parts ?? item?.candidates?.[0]?.content?.parts ?? [];\n  let raw = parts.map(p => p.text || '').join('') || item.text || item.output || '';\n  if (!raw) throw new Error('No text found. Keys: ' + Object.keys(item).join(', '));\n  raw = raw.replace(/```json|```/g, '').trim();\n  d = JSON.parse(raw.slice(raw.indexOf('{'), raw.lastIndexOf('}') + 1));\n}\nconst text = [d.glance, d.explore, d.deep_dive, d.remember].join(' ');\nconst flags = new Set(d.flags || []);\nif (/\\d/.test(text)) flags.add('dates or numbers');\nif (text.includes('\"') || text.includes('\\u201C')) flags.add('quote');\nif (/\\b(invented|first|credited|discovered|designed by|pioneered)\\b/i.test(text)) flags.add('attribution');\nreturn [{\n  json: {\n    backlogId: src.id,\n    title: src.Title,\n    pillar: src.Pillar,\n    glance: d.glance,\n    explore: d.explore,\n    deep_dive: d.deep_dive,\n    remember: d.remember,\n    sources: (d.sources || []).join('\\n'),\n    flags: [...flags].join('; '),\n    status: flags.size > 0 ? 'needs_review' : 'drafted'\n  }\n}];"
        },
        "name": "Parse and Flag",
        "type": "n8n-nodes-base.code",
