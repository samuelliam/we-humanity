      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        832,
        240
      ],
      "parameters": {
        "jsCode": "const story = $('Fetch Approved Stories').first().json;\nconst assets = $input.all().map(x => x.json).sort((a, b) => (a['Slide Index'] || 0) - (b['Slide Index'] || 0));\nif (assets.length !== 6) throw new Error('Expected 6 linked Assets for Story ' + story.id + ', got ' + assets.length);\nfor (let i = 0; i < 6; i++) {\n  if (assets[i]['Slide Index'] !== i + 1) throw new Error('Missing Slide Index ' + (i + 1));\n  if (!assets[i].Credit) throw new Error('Missing Credit on Slide ' + (i + 1));\n}\nreturn [{\n  json: {\n    storyId: story.id,\n    title: story.Title,\n    pillar: story.Pillar,\n    story,\n    assets,\n    xThread: {\n      post1: (story.Title || '') + ' — ' + (story.Glance || ''),\n      post2: (story.Remember || '') + ' (1/2 → 2/2)'\n    }\n  }\n}];"
      }
    },
